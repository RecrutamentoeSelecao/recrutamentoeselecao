# Copie para .env e preencha. NUNCA versione o .env com valores reais.
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://rs:troque-esta-senha@localhost:5432/rs_fagron?schema=public

# JWT: gere com `openssl rand -base64 48`. Mínimo de 32 caracteres.
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TTL_DIAS=7

# Origem(ns) permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Fuso usado para "hoje" nas regras de prazo (datas são dias civis)
TZ_NEGOCIO=America/Sao_Paulo

# LGPD: retenção padrão de dados de candidato sem contratação (meses)
RETENCAO_CANDIDATO_MESES=24

# Usuário administrador criado pelo seed (troque a senha no primeiro acesso)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_SENHA=troque-esta-senha-forte
