// Modelo de dados do Controle de Vagas, SLA e Experiência.
// Nomes em português para casar com o domínio (docs/01-inventario-sistema-atual.md).
// Datas de negócio (abertura, etapas, admissão...) são dias civis: @db.Date, lidas como UTC 00:00.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Papel {
  ADMIN
  RECRUTADOR
  GESTOR
  LEITOR
}

/// Resposta de item de checklist / feito da integração (o legado usa SIM / NÃO / N/A)
enum Resposta {
  SIM
  NAO
  NA
}

enum SimNao {
  SIM
  NAO
}

enum EtapaCandidatura {
  TRIAGEM
  BANCO_TALENTOS
  ENTREVISTA_RH
  PARECER
  ENTREVISTA_GESTOR
  APROVADO
  REPROVADO
  DESISTIU
}

enum BaseLegal {
  CONSENTIMENTO
  EXECUCAO_CONTRATO
  LEGITIMO_INTERESSE
  OBRIGACAO_LEGAL
}

enum TipoHistoricoVaga {
  ETAPA
  STATUS
  INICIO
  APROVADO
}

enum MarcoExperiencia {
  PRIMEIRO_PERIODO
  SEGUNDO_PERIODO
}

enum RecomendacaoExperiencia {
  PRORROGAR
  EFETIVAR
  DESLIGAR
}

// ---------------------------------------------------------------- identidade

model Usuario {
  id            String         @id @default(uuid())
  nome          String
  email         String         @unique
  senhaHash     String
  papel         Papel          @default(LEITOR)
  ativo         Boolean        @default(true)
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt
  refreshTokens RefreshToken[]
  vagasGeridas  Vaga[]         @relation("GestorVaga")
  auditorias    AuditLog[]

  @@map("usuarios")
}

/// Refresh token opaco, guardado só como hash SHA-256; rotacionado a cada uso.
model RefreshToken {
  id         String    @id @default(uuid())
  usuarioId  String
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime  @default(now())

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------- configuração ("Base" e "Parâmetros")

/// Régua de SLA: prazo ACUMULADO desde a abertura, em dias corridos. O maior é o TTF alvo.
model EtapaRegua {
  ordem   Int    @id
  nome    String
  slaDias Int

  @@map("etapas_regua")
}

/// Parâmetros chave/valor (agingVerde, agingAmarelo, expP1, expP2, slaCiee, empresaIntegracao...)
model Parametro {
  chave        String   @id
  valor        Json
  atualizadoEm DateTime @updatedAt

  @@map("parametros")
}

model Feriado {
  data      DateTime @id @db.Date
  descricao String   @default("")

  @@map("feriados")
}

/// Listas da Base (empresas, cargos, statusVaga, checklist, instituicoes, tamanhos...)
model ItemLista {
  id    String  @id @default(uuid())
  lista String
  valor String
  ordem Int     @default(0)
  cor   String?

  @@unique([lista, valor])
  @@index([lista, ordem])
  @@map("itens_lista")
}

/// Gerador de códigos legíveis (V0001, A0001, E0001...)
model Sequencia {
  prefixo String @id
  valor   Int    @default(0)

  @@map("sequencias")
}

// ---------------------------------------------------------------- recrutamento

model Vaga {
  id              String    @id @default(uuid())
  codigo          String    @unique
  empresa         String    @default("")
  cargo           String    @default("")
  depto           String    @default("")
  tipo            String    @default("")
  substituido     String    @default("")
  gestor          String    @default("")
  /// Usuário com papel GESTOR que enxerga esta vaga (visão restrita)
  gestorUsuarioId String?
  gestorUsuario   Usuario?  @relation("GestorVaga", fields: [gestorUsuarioId], references: [id], onDelete: SetNull)
  salario         Decimal?  @db.Decimal(12, 2)
  abertura        DateTime? @db.Date
  status          String    @default("TRIAR")
  prioridade      String    @default("")
  /// Nome de quem foi aprovado (o legado guarda texto livre)
  aprovado        String    @default("")
  /// Data de admissão (início) — alimenta TTF, experiência, integração, uniforme
  inicio          DateTime? @db.Date
  talent          String    @default("")
  medirSla        Boolean   @default(true)
  obs             String    @default("")
  versao          Int       @default(1)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  etapas       VagaEtapa[]
  historico    VagaHistorico[]
  candidaturas Candidatura[]
  admissao     Admissao?
  experiencia  Experiencia?
  integracao   Integracao?
  contrato     ContratoEstagio?
  uniforme     Uniforme?
  notas        Nota[]

  @@index([status])
  @@index([empresa])
  @@index([gestorUsuarioId])
  @@map("vagas")
}

/// Data em que cada etapa da régua foi cumprida (uma linha por etapa preenchida)
model VagaEtapa {
  vagaId          String
  vaga            Vaga     @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  ordem           Int
  nome            String
  data            DateTime @db.Date
  registradaEm    DateTime @default(now())
  registradaPorId String?

  @@id([vagaId, ordem])
  @@map("vaga_etapas")
}

/// Trilha de mudanças da vaga com carimbo de tempo (base para SLA, TTF e TTH auditáveis)
model VagaHistorico {
  id         String            @id @default(uuid())
  vagaId     String
  vaga       Vaga              @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  tipo       TipoHistoricoVaga
  etapaOrdem Int?
  de         String?
  para       String?
  em         DateTime          @default(now())
  porId      String?

  @@index([vagaId, em])
  @@map("vaga_historico")
}

model Candidato {
  id                      String    @id @default(uuid())
  codigoLegado            String?   @unique
  nome                    String
  email                   String?
  telefone                String?
  cpf                     String?   @unique
  cidade                  String?
  fonte                   String?
  curriculoUrl            String?
  curriculoTexto          String?
  // LGPD
  baseLegal               BaseLegal @default(CONSENTIMENTO)
  consentimentoEm         DateTime?
  consentimentoVersao     String?
  consentimentoRevogadoEm DateTime?
  retencaoAte             DateTime? @db.Date
  anonimizadoEm           DateTime?
  criadoEm                DateTime  @default(now())
  atualizadoEm            DateTime  @updatedAt

  candidaturas Candidatura[]

  @@index([email])
  @@index([retencaoAte])
  @@map("candidatos")
}

model Candidatura {
  id                String              @id @default(uuid())
  candidatoId       String
  candidato         Candidato           @relation(fields: [candidatoId], references: [id], onDelete: Cascade)
  vagaId            String
  vaga              Vaga                @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  etapa             EtapaCandidatura    @default(TRIAGEM)
  statusLegado      String?
  fonte             String?
  motivoPerda       String?
  /// Ponto de extensão: scorecard estruturado de entrevista (benchmark, rec. 6)
  scorecard         Json?
  etapaAtualizadaEm DateTime            @default(now())
  criadoEm          DateTime            @default(now())
  atualizadoEm      DateTime            @updatedAt
  eventos           CandidaturaEvento[]

  @@unique([candidatoId, vagaId])
  @@index([vagaId, etapa])
  @@map("candidaturas")
}

model CandidaturaEvento {
  id            String            @id @default(uuid())
  candidaturaId String
  candidatura   Candidatura       @relation(fields: [candidaturaId], references: [id], onDelete: Cascade)
  de            EtapaCandidatura?
  para          EtapaCandidatura
  motivo        String?
  em            DateTime          @default(now())
  porId         String?

  @@index([candidaturaId, em])
  @@map("candidatura_eventos")
}

// ---------------------------------------------------------------- pós-aprovação

/// Nasce sozinha quando a vaga é aprovada (data da última etapa) ou fechada pelo status. 1:1 com a vaga.
model Admissao {
  id           String         @id @default(uuid())
  codigo       String         @unique
  vagaId       String         @unique
  vaga         Vaga           @relation(fields: [vagaId], references: [id], onDelete: Cascade)
  obs          String         @default("")
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  itens        AdmissaoItem[]

  @@map("admissoes")
}

/// Um item do checklist. A tarefa é copiada (snapshot) para não desalinhar se a Base mudar.
model AdmissaoItem {
  admissaoId   String
  admissao     Admissao  @relation(fields: [admissaoId], references: [id], onDelete: Cascade)
  ordem        Int
  tarefa       String
  resposta     Resposta  @default(NAO)
  respondidoEm DateTime?

  @@id([admissaoId, ordem])
  @@map("admissao_itens")
}

/// Contrato de experiência CLT: limite1 = admissão + 45 − 1; limite2 = admissão + 90 − 1 (dias corridos)
model Experiencia {
  id           String                 @id @default(uuid())
  codigo       String                 @unique
  vagaId       String?                @unique
  vaga         Vaga?                  @relation(fields: [vagaId], references: [id], onDelete: SetNull)
  nome         String                 @default("")
  empresa      String                 @default("")
  cargo        String                 @default("")
  depto        String                 @default("")
  gestor       String                 @default("")
  admissao     DateTime?              @db.Date
  limite1      DateTime?              @db.Date
  limite2      DateTime?              @db.Date
  env1         DateTime?              @db.Date
  prorrog      SimNao?
  env2         DateTime?              @db.Date
  efetiv       SimNao?
  obs          String                 @default("")
  criadoEm     DateTime               @default(now())
  atualizadoEm DateTime               @updatedAt
  avaliacoes   AvaliacaoExperiencia[]

  @@index([limite1])
  @@index([limite2])
  @@map("experiencias")
}

/// Formulário de avaliação 45/90 dias (benchmark, rec. 1)
model AvaliacaoExperiencia {
  id            String                  @id @default(uuid())
  experienciaId String
  experiencia   Experiencia             @relation(fields: [experienciaId], references: [id], onDelete: Cascade)
  marco         MarcoExperiencia
  avaliadorId   String?
  nota          Int?
  recomendacao  RecomendacaoExperiencia
  comentario    String                  @default("")
  criterios     Json?
  criadoEm      DateTime                @default(now())

  @@index([experienciaId])
  @@map("avaliacoes_experiencia")
}

model Integracao {
  id           String    @id @default(uuid())
  codigo       String    @unique
  vagaId       String?   @unique
  vaga         Vaga?     @relation(fields: [vagaId], references: [id], onDelete: SetNull)
  admissao     DateTime? @db.Date
  nome         String    @default("")
  empresa      String    @default("")
  setor        String    @default("")
  gestor       String    @default("")
  feito        Resposta  @default(NAO)
  dataIntegr   DateTime? @db.Date
  obs          String    @default("")
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@map("integracoes")
}

/// Contrato de estágio (CIEE): limite = solicitação + slaCiee dias úteis (feriados da Base)
model ContratoEstagio {
  id           String    @id @default(uuid())
  codigo       String    @unique
  vagaId       String?   @unique
  vaga         Vaga?     @relation(fields: [vagaId], references: [id], onDelete: SetNull)
  nome         String    @default("")
  empresa      String    @default("")
  faculdade    String    @default("")
  solic        DateTime? @db.Date
  retorno      DateTime? @db.Date
  assinado     DateTime? @db.Date
  obs          String    @default("")
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@map("contratos_estagio")
}

/// Atenção LGPD: CPF, nascimento e telefone.
model Uniforme {
  id           String    @id @default(uuid())
  codigo       String    @unique
  vagaId       String?   @unique
  vaga         Vaga?     @relation(fields: [vagaId], references: [id], onDelete: SetNull)
  empresa      String    @default("")
  nome         String    @default("")
  /// "NOVA POSIÇÃO" | "REPOSIÇÃO"
  tipoVaga     String    @default("")
  nascimento   DateTime? @db.Date
  telefone     String    @default("")
  cpf          String    @default("")
  admissao     DateTime? @db.Date
  cargo        String    @default("")
  setor        String    @default("")
  terceiro     String    @default("NA")
  sapato       String    @default("")
  camisa       String    @default("")
  calca        String    @default("")
  entregue     SimNao?
  dataEntrega  DateTime? @db.Date
  obs          String    @default("")
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  @@map("uniformes")
}

model Nota {
  id      String    @id @default(uuid())
  codigo  String    @unique
  texto   String    @db.VarChar(400)
  vagaId  String?
  vaga    Vaga?     @relation(fields: [vagaId], references: [id], onDelete: SetNull)
  quando  DateTime? @db.Date
  feito   Boolean   @default(false)
  criada  DateTime  @default(now())
  autorId String?

  @@index([quando])
  @@map("notas")
}

// ---------------------------------------------------------------- auditoria

/// Quem / quando / o quê / antes / depois. Gravado na mesma transação da mutação.
model AuditLog {
  id          String   @id @default(uuid())
  em          DateTime @default(now())
  usuarioId   String?
  usuario     Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioNome String?
  acao        String
  entidade    String
  entidadeId  String?
  antes       Json?
  depois      Json?
  ip          String?
  userAgent   String?

  @@index([entidade, entidadeId])
  @@index([usuarioId, em])
  @@index([em])
  @@map("audit_log")
}
